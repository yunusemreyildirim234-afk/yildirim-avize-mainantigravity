# ─────────────────────────────────────────────────────────────
# Yıldırım Avize — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın. `.env` ASLA git'e eklenmemelidir.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (docker-compose.yml ile uyumlu)
DATABASE_URL="postgresql://emre:yildirim123@localhost:5432/avize_db?schema=public"

# Sitenin herkese açık adresi (webhook tanımı için https:// olmalı)
NEXT_PUBLIC_SITE_URL="https://www.ornek-alan-adiniz.com"

# Yönetim paneli koruması (HTTP Basic Auth). Üretimde ZORUNLUDUR.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# ── Kargonomi API v1 ─────────────────────────────────────────
# Taban adres `app.kargonomi.com.tr/api/v1` olmalıdır (kargonomi.com.tr pazarlama sitesidir).
KARGONOMI_BASE_URL="https://app.kargonomi.com.tr/api/v1"
KARGONOMI_API_TOKEN=""
# Webhook imza anahtarı (Kargonomi panelinden / webhook oluşturma yanıtından)
KARGONOMI_WEBHOOK_SECRET=""
# Depo oluşturulduktan sonra dönen kimlik
# KARGONOMI_WAREHOUSE_ID=""
# Ülke kimliği (il listesi için; Kargonomi panelinden doğrulayın)
KARGONOMI_COUNTRY_ID="1"

# Gönderici / depo bilgileri (Beyoğlu – Şişhane atölyesi)
KARGONOMI_SENDER_NAME="Yıldırım Avize Aydınlatma"
KARGONOMI_SENDER_EMAIL="iletisim@yildirimavize.com"
KARGONOMI_SENDER_PHONE="5372114223"
KARGONOMI_SENDER_TAX_NUMBER=""
KARGONOMI_SENDER_TAX_PLACE="Beyoğlu"
KARGONOMI_SENDER_ADDRESS="Bereketzade Mah. Tevfikiye Han, İskender Cad, Nazlı Hanım Sk. No:6 D:11, Şişhane Beyoğlu / İstanbul"
KARGONOMI_SENDER_STATE_ID="34"
KARGONOMI_SENDER_CITY_ID="425"

# E-posta bildirimleri (Resend)
RESEND_API_KEY=""
